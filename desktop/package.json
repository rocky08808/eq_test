{
  "name": "iqtest-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cc.olxp.exam",
    "productName": "候选考试",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "win": {
      "target": "portable",
      "artifactName": "候选考试.${ext}",
      "signAndEditExecutable": false
    }
  }
}
